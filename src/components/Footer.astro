---
import Crayon from '../assets/motifs/crayon.svg';
import LienSouligne from './LienSouligne.astro';
import Logo from '../assets/logo/logo-de-main-en-main.svg';
import '../styles/global.css';
---

<footer class="relative overflow-hidden bg-creme px-6 py-12 md:px-12 md:py-16 border-t border-sable">
  <div class="mx-auto max-w-6xl relative z-10">

    <!-- Section Principale : Logo/Slogan à gauche, Listes de liens à droite -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-12 mb-12">
      
      <!-- Bloc Logo & Slogan -->
      <div class="flex flex-col gap-4">
        <Logo class="h-24 w-auto self-start text-encre md:h-28" />
        <p class="text-sm md:text-base text-gris">
          Méert × Oxford — Transmettez votre savoir-faire
        </p>
      </div>

      <!-- Bloc Listes de liens (Le site / Les marques) -->
      <div class="grid grid-cols-2 gap-12 sm:gap-20 w-full lg:w-auto">
        
        <!-- Le site -->
        <div class="flex flex-col gap-3">
          <h2 class="text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-gris">
            Le site
          </h2>
          <ul class="flex flex-col gap-2.5">
            <li><LienSouligne href="#collab" class="text-base text-encre">La collab</LienSouligne></li>
            <li><LienSouligne href="#produit" class="text-base text-encre">Le produit</LienSouligne></li>
            <li><LienSouligne href="#evenement" class="text-base text-encre">L’événement</LienSouligne></li>
            <li><LienSouligne class="text-base text-encre" data-reservation-ouvrir>Réserver</LienSouligne></li>
          </ul>
        </div>

        <!-- Les marques -->
        <div class="flex flex-col gap-3">
          <h2 class="text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-gris">
            Les marques
          </h2>
          <ul class="flex flex-col gap-2.5">
            <li><LienSouligne href="https://www.meert.fr" target="_blank" rel="noopener" class="text-base text-encre">Méert</LienSouligne></li>
            <li><LienSouligne href="https://www.oxford.fr" target="_blank" rel="noopener" class="text-base text-encre">Oxford</LienSouligne></li>
            <li><LienSouligne href="#contact" class="text-base text-encre">Contact</LienSouligne></li>
            <li><LienSouligne href="#presse" class="text-base text-encre">Presse</LienSouligne></li>
          </ul>
        </div>

      </div>
    </div>


    <!-- IMAGE DU CRAYON (Affichée uniquement sur grand écran / Desktop) -->
    <div class="hidden lg:block relative w-full my-8 pointer-events-none">
      <img 
        src={Crayon.src} 
        alt="" 
        class="w-3/4 max-w-2xl h-auto object-contain opacity-90" 
      />
    </div>


    <!-- Ligne de séparation -->
    <div class="w-full h-px bg-sable my-8"></div>


    <!-- Bas du footer : Copyright & Mentions légales -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-gris">
      
      <p>© 2026 Méert × Oxford</p>

      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <LienSouligne href="#mentions-legales">Mentions légales</LienSouligne>
        <LienSouligne href="#confidentialite">Politique de confidentialité</LienSouligne>
        <LienSouligne href="#cookies">Cookies</LienSouligne>
        <LienSouligne href="#cgv">CGV</LienSouligne>
      </div>

    </div>

  </div>
</footer>
const crayon = 'M238.096 53.1225L344.286 19.9384L668.661 19.1088L667.831 85.4771H678.616L680.275 20.768H690.23L689.401 86.3067H700.186L701.015 19.9384H712.63V87.1363L710.97 19.1088H713.459L718.437 19.9384L722.585 21.5976L726.733 24.0864L731.711 29.064L734.199 33.212L736.688 37.3601L738.347 42.3377L740.007 50.6337V58.1002L739.177 63.0778L736.688 69.7146L734.199 74.6922L730.881 78.0106L727.563 81.3291L723.415 83.8179L716.778 85.4771L712.63 86.3067L668.661 87.1363L345.945 85.4771L236.437 53.9521L268.792 43.1673H269.621L271.28 43.9969L272.94 45.6561L274.599 48.9745L275.428 53.1225L273.769 58.1002L272.94 60.589L270.451 62.2482H269.621L238.096 53.1225ZM238.096 53.1225L344.286 20.768L340.138 23.2568L336.819 26.5752L335.16 29.8936L334.33 31.5528L335.16 33.212L336.819 35.7009L345.115 42.3377L667.831 41.5081L668.661 63.9074H345.115L337.649 69.7146L335.16 73.033V74.6922V76.3514L337.649 78.8402L345.115 85.4771';
---

<div class="pointer-events-none my-8 flex items-center text-sable" aria-hidden="true" data-crayon-trait>
	<!-- filet extensible : même hauteur que le trait du dessin (≈ 1,5 px) -->
	<span class="h-[1.5px] flex-1 origin-left rounded-full bg-current" data-trait></span>
	<!-- la mine (x 238, y 53) est au milieu vertical du dessin : le filet arrive pile sur le gribouillis -->
	<svg
		viewBox="0 17.1225 744 72"
		class="w-56 shrink-0 overflow-visible md:w-96 lg:w-[620px]"
		fill="none"
		stroke="currentColor"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<!-- épaisseur en unités du dessin, ajustée par taille pour rester à ≈ 1,5 px à l'écran -->
		<g class="[stroke-width:5] md:[stroke-width:2.9] lg:[stroke-width:1.8]">
			<path d={gribouillis} data-gribouillis></path>
			<path d={crayon} data-crayon></path>
		</g>
	</svg>
</div>

<script>
	import { gsap, mouvementReduit } from '../scripts/gsap';

	const MINE = { x: 238.096, y: 53.1225 }; // pointe du crayon dans le repère du dessin

	document.querySelectorAll<HTMLElement>('[data-crayon-trait]').forEach((racine) => {
		if (mouvementReduit()) return;
		const trait = racine.querySelector<HTMLElement>('[data-trait]')!;
		const svg = racine.querySelector('svg')!;
		const gribouillis = racine.querySelector<SVGPathElement>('[data-gribouillis]')!;
		const crayon = racine.querySelector<SVGPathElement>('[data-crayon]')!;
		const longueur = gribouillis.getTotalLength();

		// Avancée commune (en unités du dessin) : d'abord le filet HTML, puis le gribouillis
		const etat = { s: 0 };
		// longueur du filet ramenée au repère du dessin
		let filet = 1;
		const mesurer = () => (filet = trait.offsetWidth / (svg.getBoundingClientRect().width / 744) || 1);
		const placer = () => {
			const { s } = etat;
			let pointe;
			if (s < filet) {
				trait.style.scale = `${s / filet} 1`;
				gribouillis.style.strokeDashoffset = String(longueur);
				pointe = { x: s - filet, y: MINE.y };
			} else {
				const trace = Math.min(s - filet, longueur);
				trait.style.scale = '1 1';
				gribouillis.style.strokeDashoffset = String(longueur - trace);
				pointe = gribouillis.getPointAtLength(trace);
			}
			crayon.setAttribute('transform', `translate(${pointe.x - MINE.x} ${pointe.y - MINE.y})`);
		};

		gribouillis.style.strokeDasharray = String(longueur);
		mesurer();
		placer();

		gsap.to(etat, {
			s: () => mesurer() + longueur,
			duration: 3.2,
			ease: 'power1.inOut',
			onUpdate: placer,
			scrollTrigger: { trigger: racine, start: 'top 90%', once: true },
		});
	});
</script>

---
import BoutonCoulis from './boutons/BoutonCoulis.astro';
import Fouet from '../assets/motifs/fouet.svg';
import MotifPoche from '../assets/motifs/poche-a-douille.svg';
import RappelCourbe from './RappelCourbe.astro';
import PostIt from '../assets/objets/post-it-reserver.svg';
import TicketMarron from '../assets/objets/ticket-atelier.svg';
import ModaleReservation from './ModaleReservation.astro';
---

<section id="evenement" class="relative overflow-hidden bg-creme px-6 py-16 md:px-12 md:py-24">

  <!-- Rappel de la courbe de la hero -->
  <RappelCourbe cote="gauche" variante="vague" class="top-[30%] left-0 aspect-[1/2.4] w-[clamp(60px,12vw,170px)]" />

  <!-- Suite de la poche à douille de la section produit (même position, 33 px au-dessus de cette section) -->
  <img
    src={MotifPoche.src}
    alt=""
    class="pointer-events-none absolute -top-[33px] left-[1.646%] z-0 hidden h-auto w-[291px] max-w-none -translate-1/2 rotate-14 xl:block"
  />

    <!-- Fouet décoratif : petit, dans la marge haute à droite, à l’écart des textes -->
    <div class="absolute -right-6 top-16 pointer-events-none z-0 hidden lg:block opacity-60 w-40 xl:right-4 xl:w-56 -rotate-12">
    <img src={Fouet.src} alt="" class="w-full h-auto object-contain" />
  </div>

  <div class="mx-auto max-w-6xl relative z-10">

    <!-- En-tête de section -->
    <div class="mb-16 text-center md:mb-20">
      <!-- Badge "Sur réservation" -->
      <div class="inline-block mb-6 px-4 py-1.5 rounded-full border border-sable bg-creme shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-encre">
          Sur réservation · Places limitées
        </p>
      </div>

      <h2 class="mx-auto mb-6 text-4xl font-bold tracking-tight text-encre sm:text-5xl md:text-6xl">
        L’événement
      </h2>

      <p class="mx-auto max-w-2xl text-base leading-relaxed text-gris md:text-lg">
        Parce que le savoir-faire ne se transmet pas uniquement par les mots, nous avons
        souhaité donner vie à cette collaboration à travers un événement exclusif. Une rencontre pensée
        comme une invitation à découvrir, apprendre et partager autour de nos deux expériences.
      </p>
    </div>

    <!-- Grille des 4 cartes (1 col sur mobile, 2 sur tablette, 4 sur desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
      
      <!-- Carte 1 : L'espace Méert -->
      <article class="flex flex-col">
        <div class="h-56 mb-6 rounded-lg bg-beige/60 border border-sable flex items-center justify-center p-4">
          <span class="text-sm text-gris-clair italic">Visuel pâtisserie</span>
        </div>
        <h3 class="mb-3 text-xl font-bold text-encre">L’espace Méert</h3>
        <p class="text-sm leading-relaxed text-gris">
          Découvrir et déguster la création pâtissière exclusive imaginée pour la collaboration.
        </p>
      </article>

      <!-- Carte 2 : L'espace Oxford -->
      <article class="flex flex-col">
        <div class="h-56 mb-6 rounded-lg bg-beige/60 border border-sable flex items-center justify-center p-4">
          <span class="text-sm text-gris-clair italic">Visuel livre de recettes</span>
        </div>
        <h3 class="mb-3 text-xl font-bold text-encre">L’espace Oxford</h3>
        <p class="text-sm leading-relaxed text-gris">
          La présentation et la vente du livre de recettes Méert × Oxford, en édition limitée pour l’événement.
        </p>
      </article>

      <!-- Carte 3 : L'atelier d'écriture en chocolat -->
      <article class="flex flex-col">
        <div class="h-56 mb-6 rounded-lg bg-beige/60 border border-sable flex items-center justify-center p-4">
          <span class="text-sm text-gris-clair italic">Visuel atelier</span>
        </div>
        <h3 class="mb-3 text-xl font-bold text-encre">L’atelier d’écriture en chocolat</h3>
        <p class="text-sm leading-relaxed text-gris">
          Une expérience artisanale autour de l’art de l’écriture gastronomique. Chacun repart avec sa propre réalisation.
        </p>
      </article>

      <!-- Carte 4 : Les conférences -->
      <article class="flex flex-col">
        <div class="h-56 mb-6 rounded-lg bg-beige/60 border border-sable flex items-center justify-center p-4">
          <span class="text-sm text-gris-clair italic">Visuel conférence</span>
        </div>
        <h3 class="mb-3 text-xl font-bold text-encre">Les conférences</h3>
        <p class="text-sm leading-relaxed text-gris">
          Un temps d’échange autour de la transmission, des savoir-faire et de l’importance de préserver ce qui nous est cher.
        </p>
      </article>

    </div>


    <!-- BLOC D'APPEL À L'ACTION / RÉSERVATION -->
    <div class="relative max-w-3xl mx-auto mt-12 px-4">

      <!-- Post-it décoratif (Gauche) : sur le coin du cadre en tablette, à l'extérieur sur PC -->
      <div class="absolute -left-3 -top-14 z-20 w-28 -rotate-12 pointer-events-none hidden sm:block lg:-left-36 lg:top-4 lg:w-36 xl:-left-72 xl:-top-6 xl:w-40">
        <img src={PostIt.src} alt="Ne pas oublier : réserver sa place" class="w-full h-auto drop-shadow-md" data-flotte />
      </div>

      <!-- Ticket marron décoratif (Droite) : déborde du coin bas en tablette, à l'extérieur sur PC -->
      <div class="absolute -right-3 -bottom-12 z-20 w-40 rotate-6 pointer-events-none hidden sm:block lg:-right-36 lg:-bottom-6 lg:w-52 xl:-right-72 xl:top-25 xl:bottom-auto xl:w-62">
        <img src={TicketMarron.src} alt="" class="w-full h-auto drop-shadow-md" data-flotte />
      </div>

      <!-- Encadré principal de réservation -->
      <div class="relative z-10 border-2 border-encre bg-creme p-8 md:p-12 text-center shadow-sm">
        
        <!-- Compteur de places -->
        <div class="flex items-center justify-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-bordeaux animate-pulse"></span>
          <span class="text-sm font-semibold tracking-wide text-encre" data-places-restantes>Places limitées</span>
        </div>

        <p class="max-w-xl mx-auto text-base text-gris mb-8 leading-relaxed">
          Nous vous invitons à partager cette expérience avec nous et avec vos proches. Une place par adresse e-mail.
        </p>

        <!-- Bouton de réservation centré -->
        <BoutonCoulis
          libelle="Réserver sa place"
          class="mx-auto h-13 w-60 rounded-sm text-sm font-medium shadow-md md:text-[15px] xl:h-14 xl:text-base"
          data-reservation-ouvrir
        />
      </div>

    </div>

  </div>
</section>
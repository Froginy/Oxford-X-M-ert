---
import gaufreDoree from '../assets/objets/gaufre-doree.svg';
import gaufreCaramel from '../assets/objets/gaufre-caramel.svg';
import gaufreBeige from '../assets/objets/gaufre-beige.svg';
import cahierBordeaux from '../assets/objets/cahier-bordeaux.svg';
import cahierDore from '../assets/objets/cahier-dore.svg';
import cahierChocolat from '../assets/objets/cahier-chocolat.svg';
import cahierBeige from '../assets/objets/cahier-beige.svg';

// Séquence d'une rangée (Figma « Hero – diagonale » › 1 – Chargement) : gaufres et cahiers alternés.
const motifs = [
	{ src: gaufreDoree.src, type: 'gaufre', r: -6 },
	{ src: cahierBordeaux.src, type: 'cahier', r: 5 },
	{ src: gaufreCaramel.src, type: 'gaufre', r: 4 },
	{ src: cahierDore.src, type: 'cahier', r: -7 },
	{ src: gaufreBeige.src, type: 'gaufre', r: -4 },
	{ src: cahierChocolat.src, type: 'cahier', r: 6 },
	{ src: gaufreDoree.src, type: 'gaufre', r: 7 },
	{ src: cahierBeige.src, type: 'cahier', r: -5 },
];
---

<script is:inline>
	// Avant le premier rendu : bloque le défilement pendant le chargement.
	// Sécurité : si le script du rideau ne s'exécute pas, on libère la page.
	document.documentElement.dataset.chargement = 'en-cours';
	setTimeout(function () {
		var rideau = document.getElementById('chargement');
		if (document.documentElement.dataset.chargement !== 'en-cours' || (rideau && rideau.dataset.actif)) return;
		if (rideau) rideau.remove();
		delete document.documentElement.dataset.chargement;
		window.dispatchEvent(new Event('chargement:fini'));
	}, 10000);
</script>

<div id="chargement" class="fixed inset-0 z-100 flex items-center justify-center" data-motifs={JSON.stringify(motifs)}>
	<div class="absolute inset-y-0 left-0 w-1/2 overflow-hidden bg-creme" data-rideau aria-hidden="true">
		<div class="absolute top-0 left-0" data-nappe></div>
	</div>
	<div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden bg-creme" data-rideau aria-hidden="true">
		<div class="absolute top-0 left-0" data-nappe></div>
	</div>

	<div
		class="relative flex flex-col items-center gap-3.5 border border-encre bg-creme px-10 py-7"
		role="progressbar"
		aria-label="Chargement du site"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow="0"
		data-indicateur
	>
		<p class="text-base font-medium whitespace-nowrap text-encre">Chargement… <span data-pourcentage>0</span>&nbsp;%</p>
		<div class="h-1.5 w-60 overflow-hidden rounded-[3px] bg-sable">
			<div class="h-full origin-left scale-x-0 rounded-[3px] bg-encre" data-barre></div>
		</div>
	</div>
</div>

<style is:global>
	html[data-chargement='en-cours'] {
		overflow: hidden;
	}
</style>

<script>
	import { gsap, mouvementReduit } from '../scripts/gsap';
	import { EVENEMENT_CHARGEMENT_FINI } from '../scripts/chargement';

	type Motif = { src: string; type: 'gaufre' | 'cahier'; r: number };

	const DUREE_MINIMALE = 1200; // ms : le rideau reste visible au moins ce temps
	const DUREE_MAXIMALE = 6000; // ms : au-delà, on ouvre même si des images chargent encore
	const PERIODE = 4; // la nappe se répète après 4 cellules en diagonale (8 motifs, décalage de 3 par rangée)

	const racine = document.getElementById('chargement');
	if (racine) lancer(racine);

	function lancer(racine: HTMLElement) {
		racine.dataset.actif = '';
		const motifs: Motif[] = JSON.parse(racine.dataset.motifs ?? '[]');
		const [gauche, droite] = racine.querySelectorAll<HTMLElement>('[data-rideau]');
		const nappes = racine.querySelectorAll<HTMLElement>('[data-nappe]');
		const indicateur = racine.querySelector<HTMLElement>('[data-indicateur]')!;
		const pourcentage = racine.querySelector<HTMLElement>('[data-pourcentage]')!;
		const barre = racine.querySelector<HTMLElement>('[data-barre]')!;
		const reduit = mouvementReduit();

		// Nappe de motifs, assez grande pour couvrir l'écran pendant tout un cycle de dérive
		const echelle = gsap.utils.clamp(0.7, 1, window.innerWidth / 1440);
		const cellule = { l: 170 * echelle, h: 150 * echelle };
		const largeur = { gaufre: 118 * echelle, cahier: 76 * echelle };
		const colonnes = Math.ceil(window.innerWidth / cellule.l) + PERIODE + 1;
		const rangees = Math.ceil(window.innerHeight / cellule.h) + PERIODE + 1;

		const fragment = document.createDocumentFragment();
		for (let r = 0; r < rangees; r++) {
			for (let c = 0; c < colonnes; c++) {
				// Décalage de 3 par rangée : alternance en damier, et nappe identique après (-PERIODE, +PERIODE) cellules
				const motif = motifs[(c + 3 * r) % motifs.length];
				const image = new Image();
				image.src = motif.src;
				image.alt = '';
				image.decoding = 'async';
				image.className = 'absolute h-auto max-w-none -translate-1/2';
				Object.assign(image.style, {
					left: `${(c + 0.5) * cellule.l}px`,
					top: `${(r + 0.5) * cellule.h}px`,
					width: `${largeur[motif.type]}px`,
					rotate: `${motif.r}deg`,
				});
				fragment.append(image);
			}
		}
		nappes.forEach((nappe, i) => {
			nappe.append(i === 0 ? fragment.cloneNode(true) : fragment);
			Object.assign(nappe.style, {
				width: `${colonnes * cellule.l}px`,
				height: `${rangees * cellule.h}px`,
				top: `${-PERIODE * cellule.h}px`,
			});
		});
		// Le pan droit montre la suite de la même nappe
		nappes[1].style.left = `${-gauche.offsetWidth}px`;

		// Dérive continue du haut-droite vers le bas-gauche
		const derive = reduit
			? null
			: gsap.to(nappes, {
					x: -PERIODE * cellule.l,
					y: PERIODE * cellule.h,
					duration: 14,
					ease: 'none',
					repeat: -1,
				});

		// Progression : images de la page chargées, puis 100 % à l'événement load
		const etat = { p: 0 };
		const afficher = () => {
			const valeur = Math.round(etat.p);
			pourcentage.textContent = String(valeur);
			barre.style.scale = `${etat.p / 100} 1`; // propriété `scale` (celle de la classe scale-x-0), pas transform
			indicateur.setAttribute('aria-valuenow', String(valeur));
		};
		const viser = (cible: number) =>
			gsap.to(etat, { p: cible, duration: 0.5, ease: 'power2.out', onUpdate: afficher, overwrite: true });

		const images = Array.from(document.images);
		let chargees = images.filter((image) => image.complete).length;
		const uneDePlus = () => viser((++chargees / images.length) * 90);
		images
			.filter((image) => !image.complete)
			.forEach((image) => {
				image.addEventListener('load', uneDePlus, { once: true });
				image.addEventListener('error', uneDePlus, { once: true });
			});
		viser((chargees / Math.max(images.length, 1)) * 90);

		const pageChargee = new Promise<void>((resoudre) => {
			if (document.readyState === 'complete') resoudre();
			else window.addEventListener('load', () => resoudre(), { once: true });
		});
		const attendre = (ms: number) => new Promise((resoudre) => setTimeout(resoudre, ms));

		Promise.all([Promise.race([pageChargee, attendre(DUREE_MAXIMALE)]), attendre(DUREE_MINIMALE)]).then(() => {
			const ouverture = gsap.timeline({ onComplete: terminer });
			ouverture.to(etat, { p: 100, duration: 0.35, ease: 'power1.out', onUpdate: afficher, overwrite: true });
			if (derive) ouverture.to(derive, { timeScale: 0, duration: 0.6, ease: 'power2.out' }, '<');
			ouverture.to(indicateur, { autoAlpha: 0, y: -8, duration: 0.3, ease: 'power1.in' }, '>-0.1');

			if (reduit) {
				ouverture.to(racine, { autoAlpha: 0, duration: 0.4 });
			} else {
				// Les deux pans du rideau s'écartent pour dévoiler la page
				ouverture
					.to(gauche, { xPercent: -100, boxShadow: '12px 0 32px rgba(27, 19, 16, 0.18)', duration: 1.1, ease: 'power3.inOut' }, '>-0.05')
					.to(droite, { xPercent: 100, boxShadow: '-12px 0 32px rgba(27, 19, 16, 0.18)', duration: 1.1, ease: 'power3.inOut' }, '<');
			}
		});

		function terminer() {
			derive?.kill();
			racine.remove();
			delete document.documentElement.dataset.chargement;
			window.dispatchEvent(new Event(EVENEMENT_CHARGEMENT_FINI));
		}
	}
</script>

---
import type { HTMLAttributes } from 'astro/types';

// Bouton « cahier » (repris de test_sae_interspe, NotebookButton) aux couleurs de la collab :
// couverture bordeaux à liseré et lettrage dorés, coin corné ; au survol le coin se déplie,
// révèle une page Seyès sur papier beige (distincte du papier à petits carreaux de la modale), puis le libellé est souligné au stylo.
// Taille et typo se règlent avec les classes passées au composant.
interface Props extends HTMLAttributes<'button'> {
	libelle: string;
}

const { libelle, class: classe, type = 'button', ...attributs } = Astro.props;
---

<button type={type} class:list={['bouton-cahier', classe]} {...attributs}>
	<span class="libelle-couverture">{libelle}</span>
	<!-- la page porte sa propre copie du libellé (en bordeaux) : découpée par le même clip-path,
	     la couleur change exactement le long du pli -->
	<span class="page" aria-hidden="true">
		<span class="libelle-page">
			{libelle}
			<svg class="soulignement" viewBox="0 0 200 16">
				<path d="M3 10 C40 5 75 13 112 8 S172 6 197 10" pathLength="100"></path>
			</svg>
		</span>
	</span>
	<span class="rabat" aria-hidden="true"></span>
</button>

<style>
	/* taille du coin déplié, animable grâce à @property */
	@property --pli {
		syntax: '<length>';
		inherits: false;
		initial-value: 16px;
	}

	.bouton-cahier {
		--couverture: var(--color-bordeaux);
		--couverture-dos: #4d1314; /* bordeaux plus sombre : revers du coin corné */
		--dorure: var(--color-dore); /* liseré */
		--dorure-claire: var(--color-dore-clair); /* lettrage : contraste 5,7:1 sur le bordeaux (le doré de la palette n'atteint que 3,9:1) */
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		/* unités cqw/cqh : le pli s'arrête pile quand la page couvre tout le bouton */
		container-type: size;
		border-radius: 6px;
		background: var(--couverture);
		color: var(--dorure-claire);
		cursor: pointer;
	}

	/* envoi en cours */
	.bouton-cahier[aria-busy] {
		cursor: progress;
	}

	/* liseré doré, comme sur une couverture de carnet */
	.bouton-cahier::before {
		content: '';
		position: absolute;
		inset: 4px;
		border: 1.5px solid var(--dorure);
		border-radius: 3px;
	}

	.libelle-couverture {
		position: relative;
	}

	.page {
		--pli: 16px;
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		/* page Seyès sur papier beige : se distingue du papier à petits carreaux de la modale */
		background-color: var(--color-beige);
		background-image:
			linear-gradient(90deg, transparent 22px, rgb(110 30 31 / 0.6) 22px 23.5px, transparent 23.5px),
			repeating-linear-gradient(to bottom, transparent 0 31px, rgb(110 30 31 / 0.22) 31px 32px),
			repeating-linear-gradient(to bottom, transparent 0 7px, rgb(107 91 78 / 0.18) 7px 8px),
			repeating-linear-gradient(to right, transparent 0 31px, rgb(110 30 31 / 0.14) 31px 32px);
		color: var(--couverture);
		/* filet bordeaux et léger creux : la page dépliée garde la forme du bouton */
		box-shadow:
			inset 0 0 0 1.5px rgb(110 30 31 / 0.55),
			inset 0 -8px 12px -8px rgb(28 18 15 / 0.18);
		border-radius: inherit;
		clip-path: polygon(calc(100% - var(--pli)) 0, 100% 0, 100% var(--pli));
		transition: --pli 0.45s cubic-bezier(0.5, 0, 0.75, 0);
	}

	.libelle-page {
		position: relative;
	}

	.soulignement {
		position: absolute;
		top: calc(100% + 2px);
		left: -6%;
		width: 112%;
		height: auto;
		overflow: visible;
	}

	/* tiret plus long que le trait et décalé au-delà : aucun embout arrondi ne dépasse au repos */
	.soulignement path {
		fill: none;
		stroke: var(--couverture);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 100 200;
		stroke-dashoffset: 104;
		opacity: 0;
		transition:
			opacity 0.15s,
			stroke-dashoffset 0s 0.15s;
	}

	/* le coin de la couverture replié, vu de dos */
	.rabat {
		position: absolute;
		top: 0;
		right: 0;
		width: 16px;
		height: 16px;
		background: linear-gradient(225deg, transparent 50%, var(--couverture-dos) 50%);
		box-shadow: -2px 2px 3px rgb(0 0 0 / 0.25);
		clip-path: polygon(0 0, 0 100%, 100% 100%);
		/* ne revient qu'une fois la page repliée */
		transition:
			transform 0.25s 0.4s,
			opacity 0.2s 0.4s;
	}

	/* --- survol --- */
	.bouton-cahier:is(:hover, :focus-visible) .page {
		/* assez grand pour couvrir tout le bouton en diagonale */
		--pli: calc(100cqw + 100cqh + 12px);
		transition: --pli 1.2s cubic-bezier(0.35, 0.55, 0.3, 1);
	}

	.bouton-cahier:is(:hover, :focus-visible) .rabat {
		opacity: 0;
		transform: translate(10px, -10px);
		transition:
			transform 0.2s,
			opacity 0.15s;
	}

	.bouton-cahier:is(:hover, :focus-visible) .soulignement path {
		opacity: 1;
		stroke-dashoffset: 0;
		transition:
			opacity 0s 0.9s,
			stroke-dashoffset 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.9s;
	}

	.bouton-cahier:focus-visible {
		outline: 2px solid var(--couverture);
		outline-offset: 3px;
	}

	/* Mouvement réduit : la page apparaît sans dépliage */
	@media (prefers-reduced-motion: reduce) {
		.bouton-cahier .page,
		.bouton-cahier .rabat,
		.bouton-cahier .soulignement path {
			transition: none !important;
		}
	}
</style>

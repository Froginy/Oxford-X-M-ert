---
import Burger from '../assets/header/burger.svg';
import Contour from '../assets/header/contour-ouvert.svg';
import globalStyles from '../styles/global.css';
---

<header class="fixed top-4 inset-x-0 z-50 px-4 transition-all duration-300">
  <div class="mx-auto max-w-6xl relative">

    <nav 
      id="main-nav"
      class="relative flex items-center justify-around px-6 py-3 bg-creme transition-all duration-300"
    >

    <img 
        src={Contour.src} 
        alt="" 
        class="absolute inset-0 w-full h-full pointer-events-none "
    >

      <div class="flex md:hidden items-center">
        <a href="#reserver" 
          class="rounded-full bg-dore px-6 py-2.5 text-base font-semibold text-white shadow-sm hover:opacity-90 transition-opacity"
        >
          Réserver
        </a>
      </div>

      <div class="hidden md:flex items-center gap-6 lg:gap-10">
        <a href="#collab" class="text-base font-semibold hover:opacity-75 transition-opacity">
          La collab
        </a>
        <a href="#produit" class="text-base font-semibold hover:opacity-75 transition-opacity">
          Le produit
        </a>
      </div>


      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center">
          <div class="border border-chocolat px-4 py-1.5 bg-creme rounded-full flex flex-col items-center">
            <span class="text-sm tracking-wide font-medium ">Logo</span>
          </div>
        </a>
      </div>


      <div class="hidden md:flex items-center gap-6 lg:gap-10">
        <a href="#evenement" class="text-base font-semibold text-[#211914] hover:opacity-75 transition-opacity">
          L’événement
        </a>
        <a href="#reserver" 
          class="rounded-full bg-dore px-6 py-2.5 text-base font-semibold text-white shadow-sm hover:opacity-90 transition-opacity"
        >
          Réserver
        </a>
      </div>

      <div class="flex md:hidden items-center">
        <button id="mobile-menu-btn" aria-label="Menu" class="p-1 focus:outline-none">
          <img 
          src={Burger.src} 
          alt="" 
          class="absolute inset-0 w-full h-full object-contain"
        />
        </button>
      </div>

    </nav>



    <div 
      id="scroll-nav"
      class="hidden lg:flex items-center justify-end gap-3 absolute right-0 top-0 transition-all duration-300 opacity-0 pointer-events-none -translate-y-2.5"
    >
      <a href="#reserver" 
          class="rounded-full bg-dore px-6 py-2.5 text-base font-semibold text-white shadow-sm hover:opacity-90 transition-opacity"
      >
        Réserver
      </a>

      
      <button 
        id="desktop-burger-btn"
        aria-label="Ouvrir le menu"
        class="relative flex items-center justify-center w-12 h-12 bg-creme rounded-full shadow-md hover:scale-105 transition-transform"
      >
      <img 
          src={Burger.src} 
          alt="" 
          class="absolute inset-0 w-full h-full object-contain"
        />
      </button>
    </div>

  </div>
</header>

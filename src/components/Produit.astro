---
import motifPoche from '../assets/motifs/poche-a-douille.svg';
import etiquette from '../assets/objets/etiquette-numerotee.svg';
import feuille from '../assets/objets/feuille-petits-carreaux.svg';
import RappelCourbe from './RappelCourbe.astro';
import VideoBoucle from './VideoBoucle.astro';
import { Picture } from 'astro:assets';
import livreEleganceBordeaux from '../assets/medias/livre-elegance-bordeaux.png';
import livreChandelles from '../assets/medias/livre-chandelles.png';

// Section « Produit » — Figma : Section Produit (desktop 1440, tablette 768, mobile 390).
// Visuels et vidéo du livre : réalisations de l'équipe multimédia (dossier « Projet Inter-spé »).
---

<section id="produit" class="relative overflow-hidden bg-creme px-6 pt-12 pb-16 md:px-12 md:pt-16 md:pb-20 xl:pb-20">
	<!-- Rappel de la courbe de la hero -->
	<RappelCourbe cote="droite" variante="arc" class="top-[4%] right-0 aspect-[1/2.3] w-[clamp(60px,13vw,190px)]" />
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<!-- Grand motif poche à douille au trait (desktop) : ancré au bas de la section, la section événement dessine sa suite -->
		<img
			src={motifPoche.src}
			alt=""
			class="absolute top-[calc(100%-33px)] left-[1.646%] hidden h-auto w-[291px] max-w-none -translate-1/2 rotate-14 xl:block"
		/>

		<!-- Étiquette « Édition limitée n° 042 / 300 » (rotation et ombre incluses dans l'asset) -->
		<!-- conteneur pour le placement (translate CSS), l'image flotte à l'intérieur -->
		<div class="absolute top-[61px] left-[15.6%] w-[105px] -translate-1/2 md:top-[79px] md:left-[18.1%] md:w-[146px] xl:top-[643px] xl:left-[14.2%] xl:w-[194px]">
			<img src={etiquette.src} alt="" class="block h-auto w-full max-w-none" data-flotte />
		</div>

	</div>

	<div class="relative mx-auto flex max-w-[342px] flex-col items-center text-center md:max-w-[672px] xl:max-w-[1088px]">
		
		<!-- Mobile/tablette : vidéo en pleine largeur puis les deux visuels ; desktop : visuel · vidéo · visuel -->
		<div class="mb-14 flex w-full flex-wrap gap-4 md:mb-16 md:gap-6 xl:mb-20 xl:flex-nowrap xl:items-center">
			<Picture
				src={livreEleganceBordeaux}
				formats={['avif', 'webp']}
				fallbackFormat="jpg"
				widths={[320, 640]}
				sizes="(min-width: 1280px) 280px, (min-width: 768px) 324px, 163px"
				alt="Le livre de recettes Méert × Oxford fermé, couverture crème au cachet bordeaux, posé dans la pénombre"
				pictureAttributes={{ class: 'h-[150px] min-w-0 flex-1 md:h-[220px] xl:h-[340px] xl:w-[280px] xl:flex-none' }}
				class="size-full border border-sable object-cover"
			/>
			
			<VideoBoucle
				nom="transmission-livre"
				description="Vidéo : le livre de recettes passe d’une main à l’autre, sur fond bordeaux"
				class="order-first h-[200px] w-full bg-bordeaux md:h-[340px] xl:order-none xl:h-[400px] xl:w-[480px] xl:shrink-0"
			/>
			
			<Picture
				src={livreChandelles}
				formats={['avif', 'webp']}
				fallbackFormat="jpg"
				widths={[320, 640]}
				sizes="(min-width: 1280px) 280px, (min-width: 768px) 324px, 163px"
				alt="Le livre de recettes debout entre deux bougies allumées"
				pictureAttributes={{ class: 'h-[150px] min-w-0 flex-1 md:h-[220px] xl:h-[340px] xl:w-[280px] xl:flex-none' }}
				class="size-full border border-sable object-cover"
			/>
		</div>
		
		<div class="inline-block mb-6 px-4 py-1.5 rounded-full border border-sable bg-creme shadow-sm">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-encre">
				ÉDITION LIMITÉE
			</p>
		</div>
		<h2 class="mb-4 text-2xl leading-8 font-bold text-encre md:mb-5 md:text-[30px] md:leading-[38px] xl:mb-3.5 xl:max-w-[900px] xl:text-4xl xl:leading-normal">
			Le livre de recettes Méert × Oxford
		</h2>
		<p class="text-sm leading-6 text-gris md:max-w-[585px] md:text-[15px] md:leading-[25px] xl:max-w-[900px] xl:text-[17px] xl:leading-7">
			Imaginé comme un livre de famille&nbsp;: un ouvrage à compléter, à faire vivre et à transmettre au fil des années. Chaque recette y trouve sa place, avec vos annotations et vos souvenirs.
		</p>
	</div>
</section>

<script>
	import { flottement } from '../scripts/animations/flottement';

	flottement(document.querySelectorAll('#produit [data-produit-flotte]'));
</script>

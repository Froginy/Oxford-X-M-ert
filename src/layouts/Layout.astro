---
import { Font } from 'astro:assets';
import Chargement from '../components/Chargement.astro';
import FiltreCoulis from '../components/boutons/FiltreCoulis.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ModaleReservation from '../components/ModaleReservation.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-playfair" />
		<Font cssVariable="--font-caveat" />
		<!-- Sans JavaScript, l'écran de chargement (Chargement.astro) ne s'ouvrirait jamais : on le masque -->
		<noscript><style>#chargement { display: none; }</style></noscript>
		<title>Méert × Oxford — Transmettez votre savoir-faire</title>
	</head>
	<body>
		<!-- Lien d'évitement : premier arrêt au clavier, visible seulement au focus -->
		<a
			href="#contenu"
			class="fixed top-3 left-3 z-60 -translate-y-24 rounded-full bg-encre px-5 py-3 text-sm font-medium text-creme focus-visible:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bordeaux"
		>
			Aller au contenu
		</a>
		<FiltreCoulis />
		<Chargement />
		<Header />
		<main id="contenu" tabindex="-1" class="outline-none">
			<slot />
		</main>
		<Footer />
		<ModaleReservation />
	</body>
</html>

<script>
	import { flottement } from '../scripts/animations/flottement';

	// Petits objets décoratifs des sections (feuille, étiquette, post-it, ticket…) : flottement de la hero,
	// un peu plus ample pour rester perceptible (≈ 7 à 12 px, jusqu'à 2° d'oscillation)
	flottement(document.querySelectorAll('[data-flotte]'), 1.7);
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

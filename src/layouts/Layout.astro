---
import { Font } from 'astro:assets';
import Chargement from '../components/Chargement.astro';
import FiltreCoulis from '../components/boutons/FiltreCoulis.astro';
import Header from '../components/Header.astro';
import ModaleReservation from '../components/ModaleReservation.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-playfair" />
		<Font cssVariable="--font-caveat" />
		<title>Méert × Oxford — Transmettre votre savoir-faire</title>
	</head>
	<body>
		<FiltreCoulis />
		<Chargement />
		<Header />
		<slot />
		<ModaleReservation />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
